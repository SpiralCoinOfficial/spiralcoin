# SpiralCoin Environment Configuration
# Copy this file to .env and update the values

# API Server Configuration
PORT=5000
NODE_ENV=production

# Market Feed Configuration
RPC_URL=http://127.0.0.1:5000/api/blockchain
EXT_FEED=https://api.example.com/feed
MARKETFEED_PORT=4000

# SSH Configuration (for deployment scripts)
SSH_PORT=22
SSH_USER=root
SERVER_IP=127.0.0.1

# Optional: Database Configuration (if using external DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/spiralcoin

# Optional: External Services
# REDIS_URL=redis://localhost:6379
# LOG_LEVEL=info
