# SpiralCoin Environment Configuration
# Copy this file to .env and update the values

# API Server Configuration
PORT=5000
NODE_ENV=production

# Market Feed Configuration
RPC_URL=http://127.0.0.1:8545
EXT_FEED=https://api.example.com/feed
NODE_PORT=4000

# Authentication
JWT_SECRET=CHANGE_ME_SECRET

# Supply (optional overrides)
FOUNDER_WALLET=0x928072b3A3A42e7dFD577a91167DfAa08f0E653E
SUPPLY_WALLET=0xSPRC1111111111111111111111111111SupplyVault
FOUNDER_BALANCE=30562600
SUPPLY_BALANCE=20000000000000
# TOTAL_SUPPLY can be set explicitly or derived as FOUNDER_BALANCE + SUPPLY_BALANCE
# TOTAL_SUPPLY=20000030562600

# Optional: Database Configuration (if using external DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/spiralcoin

# Optional: External Services
# REDIS_URL=redis://localhost:6379
# LOG_LEVEL=info
