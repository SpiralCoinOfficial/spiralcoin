# SpiralCoin Environment Configuration
# Copy this file to .env and update the values

# API Server Configuration
PORT=5000
NODE_ENV=production

# Production Domain
BASE_URL=https://www.spiralcoin.net
API_URL=https://www.spiralcoin.net/api

# Internal RPC (for Docker network)
RPC_URL=http://daemon:8545

# Market Feed Configuration
EXT_FEED=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd
NODE_PORT=4000

# Optional: Database Configuration (if using external DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/spiralcoin

# Optional: External Services
# REDIS_URL=redis://localhost:6379
# LOG_LEVEL=info
