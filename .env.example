# SpiralCoin runtime environment template
# Copy to .env and replace placeholders.

# Core API service
NODE_ENV=production
PORT=5000
RPC_URL=http://127.0.0.1:8545
JWT_SECRET=replace-with-a-strong-random-secret

# Branding / exchange info
NAME=SpiralCoin
SYMBOL=SPRC
BASE_URL=http://localhost:5000

# Supply verification (optional overrides)
PRIMARY_WALLET=0x928072b3A3A42e7dFD577a91167DfAa08f0E653E
# Must be a real EVM address for exchange submissions (not the placeholder below)
SUPPLY_VAULT=0xSPRC1111111111111111111111111111SupplyVault
SUPPLY_MIN=22000000000000

# Market feed service
EXT_FEED=https://api.example.com/feed
NODE_PORT=4000
NODE_HOST=0.0.0.0

# Optional exchange connectors
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Optional contract metadata for exchange pack manifests
ETH_CONTRACT_ADDRESS=
BSC_CONTRACT_ADDRESS=
PRIVATE_KEY=
ETHEREUM_RPC_URL=
BSC_RPC_URL=
