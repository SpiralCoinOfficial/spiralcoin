# SpiralCoin Backend Environment Example
# Copy to .env and adjust as needed

# Backend port
PORT=5000

# RPC daemon URL (defaults to /rpc path if none specified)
RPC_URL=http://127.0.0.1:8545

# CORS allowed origins (optional)
CORS_ORIGINS=*

# Branding (optional overrides for exchange info)
NAME=SpiralCoin
SYMBOL=SPIRAL
# SpiralCoin Environment Configuration
# Copy this file to .env and update the values

# API Server Configuration
PORT=5000
NODE_ENV=production

# Market Feed Configuration
RPC_URL=http://127.0.0.1:8545
EXT_FEED=https://api.example.com/feed
NODE_PORT=4000

# Optional: Database Configuration (if using external DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/spiralcoin

# Optional: External Services
# REDIS_URL=redis://localhost:6379
# LOG_LEVEL=info
