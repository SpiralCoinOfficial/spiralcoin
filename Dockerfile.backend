# SpiralCoin Backend API Dockerfile
FROM node:lts-alpine

ENV NODE_ENV=production

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --production --silent

# Copy source
COPY server.js ./
COPY routes/ ./routes/
COPY trading_platform.html ./trading_platform.html
COPY public/ ./public/

# Expose port
EXPOSE 5000

# Run the service
CMD ["node", "server.js"]
