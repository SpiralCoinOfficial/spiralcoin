FROM ubuntu:24.04

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    g++ \
    make \
    libssl-dev \
    libboost-all-dev \
    nlohmann-json3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Create build directory
RUN mkdir -p build && cd build && \
    cmake -S .. -B . -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc)

# Expose RPC port
EXPOSE 8545

# Default command
CMD ["./build/spiralcoind"]
