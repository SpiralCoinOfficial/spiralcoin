# Copy to .env and fill values before deploying
# Private key (without 0x) of the deployer account
PRIVATE_KEY=

# Ethereum RPC URL (e.g. from Infura/Alchemy)
ETHEREUM_RPC_URL=
# BSC RPC URL (e.g. https://bsc-dataseed1.binance.org)
BSC_RPC_URL=

# Token parameters
TOKEN_NAME=SpiralCoin
TOKEN_SYMBOL=SPRC
TOKEN_DECIMALS=18
# Initial supply in whole tokens (will be scaled by 10**decimals)
TOKEN_INITIAL_SUPPLY=1000000000
# Recipient of initial supply (defaults to deployer if empty)
TOKEN_OWNER=
