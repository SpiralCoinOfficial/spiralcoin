# Copy this file to db/.env and replace EVERY "changeme" with a real strong password.
# db/.env is gitignored and must NEVER be committed.

# =============================================================================
# ACTIVE DEV DEFAULT  -->  SQLite  (no server, no Docker, ~0 disk impact)
# =============================================================================
# Use this connection URL from application code while the local Docker DB stack
# is deferred (see db/README.md for why).  File is created on first connection.
DATABASE_URL=sqlite:///./data/sqlite/spiralcoin.db

# =============================================================================
# DEFERRED  -->  Local Docker multi-engine stack (db/docker-compose.dbs.yml)
# =============================================================================
# DO NOT USE until storage situation is resolved.  Bringing this up on the
# current C: drive (97% full) or D: drive (failing FAT32 SD card) will fail
# or corrupt data.  See db/README.md.

# --- MariaDB (port 3306) ---
MARIADB_ROOT_PASSWORD=changeme-mariadb-root
MARIADB_DATABASE=spiralcoin
MARIADB_USER=spc_app
MARIADB_PASSWORD=changeme-mariadb-app

# --- MySQL (port 3307) ---
MYSQL_ROOT_PASSWORD=changeme-mysql-root
MYSQL_DATABASE=spiralcoin
MYSQL_USER=spc_app
MYSQL_PASSWORD=changeme-mysql-app

# --- PostgreSQL (port 5432) ---
POSTGRES_DB=spiralcoin
POSTGRES_USER=spc_app
POSTGRES_PASSWORD=changeme-postgres-app

# --- Redis (port 6379) ---
REDIS_PASSWORD=changeme-redis

# --- MongoDB (port 27017) ---
MONGO_ROOT_USER=spc_root
MONGO_ROOT_PASSWORD=changeme-mongo-root

# ---------- Connection URLs for application code ----------
# Copy whichever you actually use into the main spiralcoin .env file.
#
# SQLite:    sqlite:///./data/sqlite/spiralcoin.db    (DEV DEFAULT, file-based)
# MariaDB:   mariadb://spc_app:changeme-mariadb-app@127.0.0.1:3306/spiralcoin
# MySQL:     mysql://spc_app:changeme-mysql-app@127.0.0.1:3307/spiralcoin
# Postgres:  postgresql://spc_app:changeme-postgres-app@127.0.0.1:5432/spiralcoin
# Redis:     redis://:changeme-redis@127.0.0.1:6379/0
# Mongo:     mongodb://spc_root:changeme-mongo-root@127.0.0.1:27017/?authSource=admin

# =============================================================================
# PROD  -->  DigitalOcean managed databases  (recommended for exchange-readiness)
# =============================================================================
# When you provision a managed DB in your DigitalOcean account, DO will give
# you a connection URL of the form:
#   postgresql://doadmin:****@db-postgres-nyc1-xxxxx.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# Paste it here (in db/.env, NEVER in this template) as DATABASE_URL.
#DATABASE_URL=
