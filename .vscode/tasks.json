			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Start-Process http://localhost:5000/status.html"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Verify Local Stack",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
