			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Start-Process ${workspaceFolder}/EXCHANGE_PUBLISH.targets.json"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Publish Exchange Pack (Multi-Target)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/PUBLISH_EXCHANGE_PACK_MULTI.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Publish Exchange Pack (Multi-Target, Verbose)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/PUBLISH_EXCHANGE_PACK_MULTI.ps1",
