			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Publish+Verify Exchange Pack (Multi-Target)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
