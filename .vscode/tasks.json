			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Open Publish Log",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"if (Test-Path '${workspaceFolder}/build/publish_log.txt') { Start-Process '${workspaceFolder}/build/publish_log.txt' } else { Write-Host 'publish_log.txt not found. Run a publish task first.' -ForegroundColor Yellow }"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Install OpenSSH Client",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Add-WindowsCapability -Online -Name OpenSSH.Client~~~~0.0.1.0"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Test Remote SSH Connectivity",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
