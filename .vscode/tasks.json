			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Open Remote Web UI",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
