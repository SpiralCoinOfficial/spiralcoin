			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Open Exchange Info Page",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
