{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake: build SpiralCoin (MSVC)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}/build",
				"-G",
				"Ninja",
				"-DCMAKE_C_COMPILER=cl",
				"-DCMAKE_CXX_COMPILER=cl"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Remote: Sync Code + Compose Up",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/REMOTE_SYNC_CODE.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Remote: Setup Monitoring",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/REMOTE_SETUP_MONITORING.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Remote: Harden SSH",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/REMOTE_HARDEN_SSH.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Remote: Tail Backend & Daemon (200)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"ssh -o BatchMode=yes -o StrictHostKeyChecking=no root@174.138.37.6 'docker logs --tail 200 spiralcoin-backend; echo ---; docker logs --tail 200 spiralcoin-daemon'"
			]
		},
		{
			"label": "Remote: Run Health Check Now",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"ssh -o BatchMode=yes -o StrictHostKeyChecking=no root@174.138.37.6 '/root/spiralcoin/scripts/remote_health_check.sh'"
			]
		},
		{
			"label": "Remote: Tail Health Log",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"ssh -o BatchMode=yes -o StrictHostKeyChecking=no root@174.138.37.6 'tail -n 100 /var/log/spiralcoin-health.log'"
			]
		},
		{
			"label": "CMake: build SpiralCoin (MinGW)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}/build",
				"-G",
				"MinGW Makefiles",
				"-DCMAKE_C_COMPILER=gcc",
				"-DCMAKE_CXX_COMPILER=g++"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"label": "Compile main.cpp (g++)",
			"type": "shell",
			"command": "g++",
			"args": [
				"-std=c++20",
				"-I${workspaceFolder}/include",
				"${workspaceFolder}/src/main.cpp",
				"-o",
				"${workspaceFolder}/build/spiralcoind.exe"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"label": "Build SpiralCoin (MinGW g++)",
			"type": "shell",
			"command": "C:/msys64/usr/bin/bash.exe",
			"args": [
				"-lc",
				"/mingw64/bin/g++ -std=c++20 -I include src/*.cpp -o build/spiralcoind.exe -pthread -lws2_32 -lcrypt32"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build SpiralCoin (MSVC cl)",
			"type": "shell",
			"command": "cl",
			"args": [
				"/std:c++20",
				"/EHsc",
				"/I",
				"include",
				"src\\*.cpp",
				"/Fe:build\\spiralcoind.exe",
				"Ws2_32.lib",
				"Crypt32.lib"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "CMake: Configure (MinGW)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				".",
				"-B",
				"build",
				"-G",
				"MinGW Makefiles",
				"-DCMAKE_C_COMPILER=gcc",
				"-DCMAKE_CXX_COMPILER=g++"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "CMake: Build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "docker-build",
			"label": "docker-build",
			"platform": "node",
			"dockerBuild": {
				"dockerfile": "${workspaceFolder}/Dockerfile",
				"context": "${workspaceFolder}",
				"pull": true
			}
		},
		{
			"type": "docker-run",
			"label": "docker-run: release",
			"dependsOn": [
				"docker-build"
			],
			"platform": "node"
		},
		{
			"type": "docker-run",
			"label": "docker-run: debug",
			"dependsOn": [
				"docker-build"
			],
			"dockerRun": {
				"env": {
					"DEBUG": "*",
					"NODE_ENV": "development"
				}
			},
			"node": {
				"enableDebugging": true
			}
		},
		{
			"label": "Run Backend (Node)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"node ${workspaceFolder}/server.js"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Run MarketFeed (Node)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"node ${workspaceFolder}/marketfeed/server.js"
			],
			"options": {
				"cwd": "${workspaceFolder}/marketfeed"
			}
		},
		{
			"label": "Remote: Upload SSH Key",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/UPLOAD_SSH_KEY.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Auto Setup and Publish (SSH + Publish + Verify)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/AUTO_SETUP_AND_PUBLISH.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Remote: Setup SSL (Certbot)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/REMOTE_SSL_SETUP.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Start Local Stack (Backend + Daemon)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/START_LOCAL_STACK.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Install Prerequisites (Docker + MSYS2)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/INSTALL_PREREQS.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Remote: docker compose ps",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"ssh root@174.138.37.6 \"cd /root/spiralcoin && docker compose ps\""
			]
		},
		{
			"label": "Remote: docker compose logs -f",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"ssh root@174.138.37.6 \"cd /root/spiralcoin && docker compose logs -f\""
			]
		},
		{
			"label": "Deploy: docker compose logs (prod)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"docker compose -f ${workspaceFolder}/docker-compose.prod.yaml logs -f"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Deploy: docker compose down (prod)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"docker compose -f ${workspaceFolder}/docker-compose.prod.yaml down"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Deploy SpiralCoin (Docker Compose Prod)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
