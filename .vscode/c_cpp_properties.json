{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src"
      ],
      "defines": [
        "HAVE_EVMONE=0",
        "NOMINMAX"
      ],
      "browse": {
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Win32-MSVC",
      "compilerPath": "cl.exe",
      "intelliSenseMode": "windows-msvc-x64",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src"
      ],
      "defines": [
        "HAVE_EVMONE=0",
        "NOMINMAX",
        "_CRT_SECURE_NO_WARNINGS"
      ],
      "browse": {
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
